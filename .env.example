# SOVEREIGN environment template.
# Copy to `.env` and edit. NEVER commit `.env`.

# --- Runtime ---
SOVEREIGN_ENV=dev
SOVEREIGN_LOG_LEVEL=INFO
SOVEREIGN_LOG_FORMAT=json

# --- Database (MongoDB) ---
DATABASE_URL=mongodb://localhost:27017/sovereign

# --- Vector store ---
QDRANT_URL=
QDRANT_API_KEY=
# When QDRANT_URL is empty, the client runs in embedded local mode (dev only).

# --- Object storage (document blobs) ---
OBJECT_STORE_TYPE=fs
OBJECT_STORE_FS_ROOT=./storage/objects

# --- Auth ---
SOVEREIGN_JWT_SECRET=change-me-in-prod-please-use-a-long-random-string
SOVEREIGN_JWT_ALG=HS256
SOVEREIGN_JWT_TTL_MINUTES=60

# --- Network egress ---
EGRESS_ENABLED=false
EGRESS_ALLOWLIST_PATH=configs/policies.yaml

# --- Model Gateway config ---
MODEL_GATEWAY_CONFIG=configs/models.yaml

# --- App server ---
SOVEREIGN_HOST=127.0.0.1
SOVEREIGN_PORT=8000
